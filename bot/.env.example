# Copy this to bot/.env ON THE SERVER ONLY and fill in the real values there.
# Never paste a private key into a chat, a commit, or anywhere off the server.
# bot/.env is gitignored by the repo-wide `.env` / `.env.*` rule.

# Private key of the SEPARATE trading wallet (not the ArbiSmart owner key,
# not the contract). Fund this wallet with USDC.e on Polygon before going live.
TRADER_PRIVATE_KEY=

# Safety defaults — both must be changed explicitly to trade for real.
DRY_RUN=true
LIVE_CONFIRM=

# Per-trade cap in USDT/USDC.e. Start small.
MAX_TRADE_USDT=10

# Minimum expected profit (after fees) to bother acting on.
MIN_PROFIT_USDT=1

# Optional: a private Polygon RPC. Falls back to a public endpoint if unset.
RPC_URL=
