# ============================================================
# ArbiSmart frontend — copy to `.env.local` and fill in.
# Everything here is NEXT_PUBLIC_*, meaning it is bundled into the
# client and visible to anyone. Never put a secret in this file.
# ============================================================

# Deployed ArbiSmartV2 address on Polygon mainnet (chain id 137).
NEXT_PUBLIC_CONTRACT_ADDRESS=0xDCcc0561b36809454584ED1038824ca06B86c1d6

# Collateral token the contract was deployed against. This MUST match the
# contract's collateralToken() or approvals will target the wrong asset.
# The deployed contract uses Tether on Polygon (on-chain symbol: USDT0).
NEXT_PUBLIC_COLLATERAL_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Public URL of the deployment. Used for canonical links, Open Graph tags,
# and the app identity wallets display when approving a connection.
NEXT_PUBLIC_APP_URL=https://arbhub.site

# WalletConnect project id — create one free at https://cloud.reown.com
# (Reown, formerly WalletConnect Cloud). Must be exactly 32 hex characters.
#
# Anything else (unset, or an `xxxx...` placeholder) is treated as absent and
# the app falls back to browser-extension wallets only: MetaMask works, but
# Trust Wallet, Rainbow, and mobile QR sign-in do not. The dashboard shows a
# visible warning in that state so a misconfigured deploy is obvious.
#
# Add arbhub.site to the project's allowed domains in the Reown dashboard,
# otherwise connections are rejected in production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Polygon RPC endpoint. Optional: when set it is tried FIRST, with a built-in
# list of free public endpoints behind it as automatic failover, so a provider
# outage degrades instead of taking the site down.
#
# What matters here is ARCHIVE access, not raw speed. The Activity page reads
# ~3 days of event logs, and most free endpoints refuse history that deep even
# though they answer fine for recent blocks. Measured behaviour:
#
#   polygon.gateway.tenderly.co  full 120k-block range in one call  ← best free
#   polygon.drpc.org             recent blocks only, history is paid
#   polygon-bor-rpc.publicnode.com  recent blocks only, archive needs a token
#   1rpc.io/matic                eth_getLogs capped at 50 blocks
#   polygon-rpc.com              401, rpc.ankr.com needs a key
#
# Without archive access the Activity page still works, but falls back to the
# last ~20 minutes and says so on screen. Alchemy / Infura / QuickNode all
# serve the full window on their free tiers.
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.gateway.tenderly.co

# ============================================================
# The assistant (all optional — leave every one of these unset)
# ============================================================
#
# The assistant on the site works with none of this. By default it answers
# from lib/assistant/guide: written answers, figures interpolated from the
# same constants the interface renders, running in the browser. No key, no
# request, no bill, and it cannot invent a rate.
#
# Setting a key upgrades it to a conversational model that can handle wording
# the guide does not recognise. The trade is that a model can be wrong, so the
# system prompt forbids it from stating any number that is not in the facts
# block the server assembles from the contract.
#
# THESE ARE SECRETS. They have no NEXT_PUBLIC_ prefix, so they stay on the
# server and are never bundled into the browser. Put them in .env.local,
# which is gitignored, and never in this file.

# Option A — Anthropic. Paid.
# ANTHROPIC_API_KEY=

# Option B — any OpenAI-compatible endpoint, which is how you get this free.
# Google AI Studio (aistudio.google.com) issues a key with no card and a free
# tier; Groq (console.groq.com) and OpenRouter's `:free` models likewise.
# The defaults below target Google, so a key alone is enough for that one.
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASSISTANT_MODEL=gemini-flash-lite-latest

# Fiat on-ramp — optional.
#
# Without this the funding page lists the card providers as links. With a
# Transak partner key (free at transak.com) it embeds their widget instead,
# with Polygon, USDT and the connected wallet address already filled in.
# This one IS public — it identifies the integrator, not an account — so the
# NEXT_PUBLIC_ prefix is correct here.
# NEXT_PUBLIC_TRANSAK_API_KEY=
