# ============================================================
# ArbiSmart — live production values for arbhub.site
#
# Committed on purpose. Every variable here is NEXT_PUBLIC_*, which means
# Next.js compiles it into the client bundle and ships it to every visitor —
# these are already public the moment the site is served. Nothing here is a
# credential, and keeping them in the repo removes a manual step that is easy
# to get wrong.
#
# NEVER add a private key, an RPC key with billing attached, or any other
# secret to this file. Anything prefixed NEXT_PUBLIC_ is world-readable.
#
# Next.js loads .env.production automatically for `next build` / `next start`,
# so no copying is needed. To override a value on a particular server, create
# .env.local — it takes precedence and is git-ignored.
# ============================================================

NEXT_PUBLIC_APP_URL=https://arbhub.site

# ArbiSmartV3, Polygon mainnet. Verified on Sourcify with an exact match on
# creation and runtime bytecode.
# https://repo.sourcify.dev/137/0x78f273A499E43fCb2f040880435AfC6fF8104D22
#
# V3 adds a disclosed 10% development fee on deposits: 1,000 in records a
# stake of 900. The deposit UI MUST show this before the user signs — call
# quoteDeposit() and display the split. The fee is honest only if disclosed.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x78f273A499E43fCb2f040880435AfC6fF8104D22

# Tether on Polygon (on-chain symbol USDT0). Must match the contract's
# collateralToken(), which is immutable — do not change this without
# redeploying the contract.
NEXT_PUBLIC_COLLATERAL_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# WalletConnect / Reown project id. Public by design: it identifies the
# project to the relay rather than authenticating anything. The real control
# is the allowed-domains list in the Reown dashboard — arbhub.site must be
# added there or connections are rejected in production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=00a6d669500a837d18aa4adeb86fc783

# Tried first, with the app's built-in public endpoints behind it as failover.
# Tenderly is the only free endpoint measured to serve the deep eth_getLogs
# range the Activity and Portfolio pages need; swap in Alchemy/Infura/
# QuickNode if you have one.
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.gateway.tenderly.co
